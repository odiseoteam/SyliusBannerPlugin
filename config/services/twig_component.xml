<?xml version="1.0" encoding="UTF-8"?>

<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service
            id="sylius_admin.twig.component.banner.form"
            class="Sylius\Bundle\UiBundle\Twig\Component\ResourceFormComponent"
        >
            <argument type="service" id="odiseo_banner.repository.banner" />
            <argument type="service" id="form.factory" />
            <argument>%odiseo_banner.model.banner.class%</argument>
            <argument>Odiseo\SyliusBannerPlugin\Form\Type\BannerType</argument>

            <tag name="sylius.live_component.admin" key="sylius_admin:banner:form" />
        </service>

        <service
            id="odiseo_banner.twig.component.shop.banners"
            class="Odiseo\SyliusBannerPlugin\Twig\Component\Shop\BannersComponent"
        >
            <argument type="service" id="odiseo_banner.repository.banner" />
            <argument type="service" id="sylius.context.channel" />
            <argument type="service" id="odiseo_banner.provider.taxon_banners" />

            <tag
                name="sylius.twig_component"
                key="odiseo_banner:shop:banners"
                template="@OdiseoSyliusBannerPlugin/shop/banner/content/index.html.twig"
            />
        </service>

        <service
            id="odiseo_banner.twig.component.shop.taxon_banners"
            class="Odiseo\SyliusBannerPlugin\Twig\Component\Shop\TaxonBannersComponent"
        >
            <argument type="service" id="odiseo_banner.provider.taxon_banners" />
            <argument type="service" id="sylius.context.channel" />
            <argument type="service" id="request_stack" />
            <argument type="service" id="sylius.repository.taxon" />
            <argument type="service" id="sylius.context.locale" />

            <tag
                name="sylius.twig_component"
                key="odiseo_banner:shop:taxon_banners"
                template="@OdiseoSyliusBannerPlugin/shop/banner/content/index.html.twig"
            />
        </service>
    </services>
</container>
