<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <!-- Hook contexts -->
        <service id="odiseo_banner.behat.context.hook.banner_images" class="Tests\Odiseo\SyliusBannerPlugin\Behat\Context\Hook\BannerImagesContext">
            <argument type="service" id="odiseo_banner.repository.banner" />
            <argument type="service" id="odiseo_banner.storage.banner_image" />
            <tag name="fob.context_service" />
        </service>

        <!-- Setup contexts -->
        <service id="odiseo_banner.behat.context.setup.banner" class="Tests\Odiseo\SyliusBannerPlugin\Behat\Context\Setup\BannerContext">
            <argument type="service" id="odiseo_banner.factory.banner" />
            <argument type="service" id="odiseo_banner.manager.banner" />
            <argument type="service" id="odiseo_banner.storage.banner_image" />
            <argument type="service" id="sylius.behat.shared_storage" />
            <tag name="fob.context_service" />
        </service>

        <!-- UI admin contexts -->
        <service id="odiseo_banner.behat.context.ui.admin.managing_banners" class="Tests\Odiseo\SyliusBannerPlugin\Behat\Context\Ui\Admin\ManagingBannersContext">
            <argument type="service" id="sylius.behat.current_page_resolver" />
            <argument type="service" id="odiseo_banner.behat.page.admin.banner.index" />
            <argument type="service" id="odiseo_banner.behat.page.admin.banner.create" />
            <argument type="service" id="odiseo_banner.behat.page.admin.banner.update" />
            <argument type="service" id="odiseo_banner.repository.banner" />
            <argument type="service" id="odiseo_banner.manager.banner" />
            <argument type="service" id="odiseo_banner.storage.banner_image" />
            <tag name="fob.context_service" />
        </service>

        <!-- UI shop contexts -->
        <service id="odiseo_banner.behat.context.ui.shop.viewing_banners" class="Tests\Odiseo\SyliusBannerPlugin\Behat\Context\Ui\Shop\ViewingBannersContext">
            <argument type="service" id="behat.mink.default_session" />
            <argument type="service" id="sylius.behat.page.shop.home" />
            <argument type="service" id="router" />
            <tag name="fob.context_service" />
        </service>
    </services>
</container>
