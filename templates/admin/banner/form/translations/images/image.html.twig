{% set form = hookable_metadata.context.form %}
{% set locale = hookable_metadata.context.locale %}
{% set translation = form.vars.value %}

<div class="col-12 col-md-6">
    {{ form_row(form.imageFile, sylius_test_form_attribute('image', locale)) }}
    {% if translation and translation.imageName %}
        <a href="{{ translation.imageName|imagine_filter('odiseo_banner_image') }}" target="_blank" class="d-block mb-3">
            <img
                src="{{ translation.imageName|imagine_filter('odiseo_banner_image') }}"
                alt="{{ translation.imageName }}"
                class="img-fluid rounded border"
                {{ sylius_test_html_attribute('image-preview', locale) }}
            >
        </a>
    {% endif %}
</div>
